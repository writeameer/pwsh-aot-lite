<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <!-- Culture cmdlets require real ICU data; Native AOT remains enabled. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
    <!-- Override with -p:PowerShellSourceRoot=/path/to/PowerShell/src when
         using an existing checkout. The bootstrap script restores this pinned
         source tree for a fresh clone. -->
    <PowerShellSourceRoot Condition="'$(PowerShellSourceRoot)' == ''">$(MSBuildProjectDirectory)/.upstream/PowerShell/src</PowerShellSourceRoot>
    <!-- Homebrew keeps OpenSSL outside the macOS SDK search path. This is an
         optional local Native AOT link path, overridable by callers and inert
         on machines where the directory is absent. -->
    <NativeAotOpenSslLibraryPath Condition="'$(NativeAotOpenSslLibraryPath)' == '' and Exists('/opt/homebrew/opt/openssl@3/lib')">/opt/homebrew/opt/openssl@3/lib</NativeAotOpenSslLibraryPath>
    <NativeAotBrotliLibraryPath Condition="'$(NativeAotBrotliLibraryPath)' == '' and Exists('/opt/homebrew/opt/brotli/lib')">/opt/homebrew/opt/brotli/lib</NativeAotBrotliLibraryPath>
  </PropertyGroup>
  <ItemGroup>
    <LinkerArg Include="-L$(NativeAotOpenSslLibraryPath)" Condition="'$(NativeAotOpenSslLibraryPath)' != ''" />
    <LinkerArg Include="-L$(NativeAotBrotliLibraryPath)" Condition="'$(NativeAotBrotliLibraryPath)' != ''" />
    <!-- The parser proof is a separate executable project.  SDK default globbing
         would otherwise compile its Program.cs into the host executable. -->
    <Compile Remove="frontend-spike/**/*.cs" />
    <!-- The vendored generator is compiled only through its analyzer project
         reference below; it is not runner source. -->
    <Compile Remove="tools/PwshAotPortGenerator/**/*.cs" />
    <!-- The upstream-derived language extraction is a separately compiled,
         reviewed dependency. Its engine compatibility hooks remain fail-closed
         and may not become runner execution services. -->
    <Compile Remove="language/**/*.cs" />
    <!-- Approved pinned upstream language extraction. The runner consumes only
         Parser/AST types through the narrow lowerer; it does not compile the
         extraction sources or reference a PowerShell SDK. -->
    <ProjectReference Include="language/PwshAotLite.Language.csproj" />
    <ProjectReference Include="tools/PwshAotPortGenerator/PwshAotPortGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="$(PowerShellSourceRoot)/**/*.cs"
                     Link="PowerShellSource/%(RecursiveDir)%(Filename)%(Extension)" />
    <AdditionalFiles Include="$(PowerShellSourceRoot)/System.Management.Automation/resources/VerbDescriptionStrings.resx"
                     Link="PowerShellSource/System.Management.Automation/resources/VerbDescriptionStrings.resx" />
    <!-- Runtime self-test corpus; embedded so published Native AOT verification
         executes the exact checked-in evidence, not a duplicated list. -->
    <EmbeddedResource Include="tests/j1-lexical-path-corpus.json" LogicalName="PwshAotLite.J1LexicalPathCorpus" />
    <EmbeddedResource Include="tests/j2-static-record-transform-fixtures.json" LogicalName="PwshAotLite.J2StaticRecordTransformFixtures" />
  </ItemGroup>
  <Target Name="EnsurePowerShellSource" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(PowerShellSourceRoot)')"
           Text="PowerShell source was not found at '$(PowerShellSourceRoot)'. Run 'pwsh -NoProfile -File eng/Restore-Upstream.ps1' or set -p:PowerShellSourceRoot=/path/to/PowerShell/src." />
  </Target>
</Project>
